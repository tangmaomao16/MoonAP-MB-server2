{
  "schema_version": "moonap.skill.v1",
  "id": "research.bioinformatics.fastq-generator",
  "name": "FastQ Generator",
  "domain": "research",
  "category_path": "research/bioinformatics/fastq-generator",
  "description_file": "SKILL.md",
  "program_dir": "program",
  "input_types": ["synthetic", "fastq"],
  "parameters": [
    {
      "name": "read_count",
      "label": "Read count",
      "value_kind": "int",
      "default_value": "10000",
      "required": true,
      "allowed_values": []
    },
    {
      "name": "read_length",
      "label": "Read length",
      "value_kind": "int",
      "default_value": "150",
      "required": true,
      "allowed_values": []
    },
    {
      "name": "n_rate",
      "label": "N rate",
      "value_kind": "float",
      "default_value": "0.01",
      "required": true,
      "allowed_values": []
    },
    {
      "name": "random_seed",
      "label": "Random seed",
      "value_kind": "int",
      "default_value": "42",
      "required": true,
      "allowed_values": []
    }
  ],
  "runtime": {
    "kind": "moonbit",
    "compile_target": "wasm-gc",
    "protocol": "local-generation",
    "program_dir": "program",
    "browser_local": true
  }
}
